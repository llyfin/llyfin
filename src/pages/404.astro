---
import Layout from "@/layouts/Layout.astro"
import SiteHeader from "@/components/SiteHeader.astro"
import SiteFooter from "@/components/SiteFooter.astro"
import { site } from "@/site"
---

<Layout title={`Not found — ${site.name}`} description="This page doesn't exist.">
  <SiteHeader />
  <main class="mx-auto max-w-3xl px-4">
    <section class="pt-16">
      <p class="text-sm text-muted-foreground tabular-nums">404</p>
      <h1 class="mt-1 text-3xl font-semibold tracking-tight">Page not found</h1>
      <p class="mt-3 text-muted-foreground">
        The page you're looking for doesn't exist.
        <a class="underline underline-offset-4 hover:text-foreground" href="/">Browse all posts</a>.
      </p>
    </section>
    <SiteFooter />
  </main>
</Layout>

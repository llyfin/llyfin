---
import Layout from "@/layouts/Layout.astro"
import SiteHeader from "@/components/SiteHeader.astro"
import SiteFooter from "@/components/SiteFooter.astro"
import PostList from "@/components/PostList.astro"
import { getPosts } from "@/lib/blog"
import { site } from "@/site"

const posts = await getPosts()
---

<Layout title={site.title} description={site.description}>
  <SiteHeader />
  <main class="mx-auto max-w-3xl px-4">
    <section class="pt-12 pb-8 sm:pt-16">
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Notes & write-ups</h1>
      <p class="mt-3 text-muted-foreground">{site.description}</p>
    </section>
    {posts.length > 0 ? <PostList posts={posts} /> : <p class="text-muted-foreground">No posts yet.</p>}
    <SiteFooter />
  </main>
</Layout>
